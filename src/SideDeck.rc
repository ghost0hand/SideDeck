#include <windows.h>
#include "sidedeck_version.hpp"
1 VERSIONINFO
FILEVERSION SIDEDECK_VERSION_PARTS
PRODUCTVERSION SIDEDECK_VERSION_PARTS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SideDeck controller overlay\0"
            VALUE "FileVersion", SIDEDECK_VERSION "\0"
            VALUE "InternalName", "SideDeck\0"
            VALUE "OriginalFilename", "SideDeck.exe\0"
            VALUE "ProductName", "SideDeck\0"
            VALUE "ProductVersion", SIDEDECK_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
